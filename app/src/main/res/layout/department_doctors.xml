<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/department_root"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="?colorSurface"
	android:orientation="vertical"
	android:paddingLeft="16dp"
	android:paddingRight="16dp">
	<!-- Deliberately not an ActionBar: the theme is NoActionBar and the chrome-free
	     look is the point. This is the smallest thing that still gives a visible way
	     back, for people who never learned the system gesture. -->
	<ImageButton
		android:id="@+id/back_button"
		style="@style/Widget.MedBook.BackButton"
		android:contentDescription="@string/back" />
	<TextView
		android:id="@+id/department_title"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="4dp"
		android:paddingStart="12dp"
		android:paddingEnd="12dp"
		android:textAppearance="@style/TextAppearance.MedBook.Title"
		android:textColor="?colorOnSurface"
		tools:text="Cardiology Care Centre" />
	<TextView
		android:id="@+id/department_subtitle"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginBottom="8dp"
		android:paddingStart="12dp"
		android:paddingEnd="12dp"
		android:textAppearance="@style/TextAppearance.MedBook.Caption"
		android:textColor="?colorOnSurfaceVariant"
		tools:text="600 doctors" />
	<TextView
		android:id="@+id/department_empty"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="48dp"
		android:gravity="center_horizontal"
		android:text="@string/department_empty"
		android:textAppearance="@style/TextAppearance.MedBook.Caption"
		android:textColor="?colorOnSurfaceVariant"
		android:visibility="gone" />
	<androidx.recyclerview.widget.RecyclerView
		android:id="@+id/doctor_list"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:clipToPadding="false"
		android:scrollbars="none" />
</LinearLayout>

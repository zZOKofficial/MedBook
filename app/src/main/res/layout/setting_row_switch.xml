<!--
  As setting_row.xml, but the trailing chevron is a MaterialSwitch. The row root owns
  the click and calls switch.toggle() - the switch itself is clickable="false"
  focusable="false" so there is exactly one interaction target, not two overlapping
  ones. toggle() still fires OnCheckedChangeListener, so the existing handler needs no
  change for a click that arrives this way instead of a direct tap.

  A separate include rather than a switch slot added to setting_row.xml itself, for the
  same reason setting_row.xml gives for being included rather than subclassed: adding a
  MaterialSwitch there would inflate one, unused, in the eleven rows that do not want it.

  importantForAccessibility="no" on the switch is not decorative: MaterialSwitch's
  default style sets showText false, so a focused switch with no visible text
  contributes nothing to its own accessibility node, and TalkBack would otherwise
  land on this exact silent child instead of the row that actually announces state.
  See SettingsActivity#bindDemo for the delegate that reports checked/unchecked on the
  row itself.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:background="?attr/selectableItemBackground"
	android:clickable="true"
	android:focusable="true"
	android:gravity="center_vertical"
	android:minHeight="@dimen/row_min_height"
	android:orientation="horizontal"
	android:paddingStart="@dimen/row_gutter"
	android:paddingEnd="@dimen/row_gutter"
	android:paddingTop="@dimen/row_padding_vertical"
	android:paddingBottom="@dimen/row_padding_vertical">
	<LinearLayout
		android:layout_width="0dp"
		android:layout_height="wrap_content"
		android:layout_weight="1"
		android:orientation="vertical">
		<TextView
			android:id="@+id/row_title"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:textAppearance="@style/TextAppearance.MedBook.Label"
			android:textColor="?colorOnSurface"
			tools:text="Simulated booking" />
		<TextView
			android:id="@+id/row_summary"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="@dimen/row_summary_gap"
			android:textAppearance="@style/TextAppearance.MedBook.Caption"
			android:textColor="?colorOnSurfaceVariant"
			tools:text="Shows what booking would look like, using invented appointments." />
	</LinearLayout>
	<com.google.android.material.materialswitch.MaterialSwitch
		android:id="@+id/row_switch"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginStart="@dimen/row_gutter"
		android:clickable="false"
		android:focusable="false"
		android:importantForAccessibility="no" />
</LinearLayout>

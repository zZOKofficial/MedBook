<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/booking_root"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="?colorSurface"
	android:orientation="vertical"
	android:paddingLeft="16dp"
	android:paddingRight="16dp">
	<ImageButton
		android:id="@+id/back_button"
		style="@style/Widget.MedBook.BackButton"
		android:contentDescription="@string/back" />
	<!-- The error colour role, which nothing else in the app uses. A simulated
	     booking against a real doctor with a real published number is the one thing
	     on this screen a person must not misread, so it gets the loudest role there
	     is rather than a polite grey note. -->
	<TextView
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="4dp"
		android:background="?colorErrorContainer"
		android:padding="10dp"
		android:text="@string/demo_banner"
		android:textAppearance="@style/TextAppearance.MedBook.Caption"
		android:textColor="?colorOnErrorContainer" />
	<TextView
		android:id="@+id/booking_doctor"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="12dp"
		android:paddingStart="12dp"
		android:paddingEnd="12dp"
		android:textAppearance="@style/TextAppearance.MedBook.Title"
		android:textColor="?colorOnSurface"
		tools:text="Dr. Example Rahman" />
	<TextView
		android:id="@+id/booking_chamber"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:paddingStart="12dp"
		android:paddingEnd="12dp"
		android:textAppearance="@style/TextAppearance.MedBook.Caption"
		android:textColor="?colorOnSurfaceVariant"
		tools:text="Example Specialised Hospital" />
	<!-- Seven days, which is as far ahead as a pitch ever needs to look. Seven is
	     also few enough not to want a RecyclerView, the same judgement the chamber
	     cards on the profile screen already make. -->
	<HorizontalScrollView
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="12dp"
		android:clipToPadding="false"
		android:paddingStart="12dp"
		android:paddingEnd="12dp"
		android:scrollbars="none">
		<LinearLayout
			android:id="@+id/day_strip"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:orientation="horizontal" />
	</HorizontalScrollView>
	<TextView
		android:id="@+id/booking_summary"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="10dp"
		android:layout_marginBottom="6dp"
		android:paddingStart="12dp"
		android:paddingEnd="12dp"
		android:textAppearance="@style/TextAppearance.MedBook.Caption"
		android:textColor="?colorOnSurfaceVariant"
		tools:text="4 times open" />
	<androidx.recyclerview.widget.RecyclerView
		android:id="@+id/slot_grid"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:clipToPadding="false"
		android:paddingStart="8dp"
		android:paddingEnd="8dp"
		android:scrollbars="none" />
</LinearLayout>

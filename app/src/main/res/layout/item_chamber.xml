<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:layout_marginTop="10dp"
	android:background="?colorSurfaceContainerLow"
	android:orientation="vertical"
	android:padding="14dp">
	<TextView
		android:id="@+id/chamber_name"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:textAppearance="@style/TextAppearance.MedBook.Label"
		android:textColor="?colorOnSurface"
		tools:text="Example Specialised Hospital" />
	<TextView
		android:id="@+id/chamber_address"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="3dp"
		android:textAppearance="@style/TextAppearance.MedBook.Caption"
		android:textColor="?colorOnSurfaceVariant"
		tools:text="Road 1, Example Area, Dhaka" />
	<!-- The source's verbatim wording, always. The structured day list is filled only
	     from phrasings the scraper recognised, so it is often empty while this is not,
	     and a day missing from it is a day the source never mentioned rather than a day
	     the doctor is known to be away. -->
	<TextView
		android:id="@+id/chamber_hours"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="6dp"
		android:textAppearance="@style/TextAppearance.MedBook.Caption"
		android:textColor="?colorOnSurface"
		tools:text="6pm to 9pm (Sun, Wed &amp; Thu)" />
	<com.google.android.material.button.MaterialButton
		android:id="@+id/chamber_call"
		style="@style/Widget.Material3.Button.TonalButton"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginTop="10dp"
		tools:text="Call +8801700000000" />
	<!-- Demo mode only, and gone in every sense otherwise: the row is not shown, and
	     nothing in this card hints that a booking screen exists. Also gone when the
	     chamber's published hours could not be read, because there is then no honest
	     day to lay slots over. -->
	<LinearLayout
		android:id="@+id/chamber_demo_row"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="6dp"
		android:orientation="horizontal"
		android:visibility="gone">
		<com.google.android.material.button.MaterialButton
			android:id="@+id/chamber_book"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="@string/chamber_book" />
		<com.google.android.material.button.MaterialButton
			android:id="@+id/chamber_console"
			style="@style/Widget.Material3.Button.TextButton"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginStart="4dp"
			android:text="@string/chamber_console" />
	</LinearLayout>
</LinearLayout>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/licences_root"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="?colorSurface"
	android:fillViewport="true">
	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical"
		android:paddingLeft="16dp"
		android:paddingRight="16dp">
		<ImageButton
			android:id="@+id/back_button"
			android:layout_width="44dp"
			android:layout_height="44dp"
			android:layout_marginTop="4dp"
			android:background="?attr/selectableItemBackgroundBorderless"
			android:contentDescription="@string/back"
			android:scaleType="center"
			android:src="@drawable/ic_back" />
		<TextView
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="4dp"
			android:paddingStart="12dp"
			android:paddingEnd="12dp"
			android:text="@string/licences_title"
			android:textAppearance="@style/TextAppearance.MedBook.Title"
			android:textColor="?colorOnSurface" />

		<TextView
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="20dp"
			android:paddingStart="12dp"
			android:paddingEnd="12dp"
			android:lineSpacingExtra="3dp"
			android:text="@string/licences_app_body"
			android:textAppearance="@style/TextAppearance.MedBook.Body"
			android:textColor="?colorOnSurfaceVariant" />
		<View
			android:layout_width="match_parent"
			android:layout_height="1dp"
			android:layout_marginStart="12dp"
			android:layout_marginEnd="12dp"
			android:layout_marginTop="12dp"
			android:background="?colorOutlineVariant" />
		<include
			android:id="@+id/agpl_row"
			layout="@layout/setting_row"
			android:layout_width="match_parent"
			android:layout_height="wrap_content" />
		<View
			android:layout_width="match_parent"
			android:layout_height="1dp"
			android:layout_marginStart="12dp"
			android:layout_marginEnd="12dp"
			android:background="?colorOutlineVariant" />

		<!--
		  The two font licences in full, not as links. The OFL requires the licence to
		  accompany the fonts it covers, and MedBook redistributes subsets of both
		  faces inside the APK - a URL is not accompaniment. They are read from
		  res/raw at 8.8KB the pair, and stay English: they are the licences as
		  granted, not interface copy.
		-->
		<TextView
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="24dp"
			android:layout_marginBottom="6dp"
			android:paddingStart="12dp"
			android:paddingEnd="12dp"
			android:text="@string/licences_fonts_heading"
			android:textAppearance="@style/TextAppearance.MedBook.SectionHeader"
			android:textColor="?colorSecondary" />
		<TextView
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:paddingStart="12dp"
			android:paddingEnd="12dp"
			android:text="@string/licences_gabarito"
			android:textAppearance="@style/TextAppearance.MedBook.Label"
			android:textColor="?colorOnSurface" />
		<TextView
			android:id="@+id/gabarito_text"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="6dp"
			android:paddingStart="12dp"
			android:paddingEnd="12dp"
			android:textAppearance="@style/TextAppearance.MedBook.Caption"
			android:textColor="?colorOnSurfaceVariant"
			tools:text="Copyright 2023 The Gabarito Project Authors" />
		<TextView
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="20dp"
			android:paddingStart="12dp"
			android:paddingEnd="12dp"
			android:text="@string/licences_hind_siliguri"
			android:textAppearance="@style/TextAppearance.MedBook.Label"
			android:textColor="?colorOnSurface" />
		<TextView
			android:id="@+id/hind_siliguri_text"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="6dp"
			android:paddingStart="12dp"
			android:paddingEnd="12dp"
			android:textAppearance="@style/TextAppearance.MedBook.Caption"
			android:textColor="?colorOnSurfaceVariant"
			tools:text="Copyright (c) 2015 Indian Type Foundry" />

		<TextView
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="24dp"
			android:layout_marginBottom="6dp"
			android:paddingStart="12dp"
			android:paddingEnd="12dp"
			android:text="@string/licences_libraries_heading"
			android:textAppearance="@style/TextAppearance.MedBook.SectionHeader"
			android:textColor="?colorSecondary" />
		<TextView
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginBottom="24dp"
			android:paddingStart="12dp"
			android:paddingEnd="12dp"
			android:lineSpacingExtra="3dp"
			android:text="@string/licences_libraries_body"
			android:textAppearance="@style/TextAppearance.MedBook.Body"
			android:textColor="?colorOnSurfaceVariant" />
	</LinearLayout>
</ScrollView>

<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical">
	<LinearLayout
		android:id="@+id/linear_bg_home"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:paddingLeft="16dp"
		android:paddingRight="16dp"
		android:background="?colorSurface"
		android:orientation="vertical">
		<TextView
			android:id="@+id/medbook_logo"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginBottom="8dp"
			android:padding="8dp"
			android:fontFamily="@font/gabarito_extrabold"
			android:text="@string/app_name"
			android:textAppearance="@style/TextAppearance.MedBook.Wordmark"
			android:textColor="?colorPrimary" />
		<androidx.appcompat.widget.SearchView
			android:id="@+id/search_docs"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:background="@drawable/bg_search"
			app:queryHint="@string/search_hint"
			app:iconifiedByDefault="false" />
		<!-- Only shown when a search of at least 2 characters matches nothing.
		     It used to be a permanently visible "No doctors found" line sitting
		     above 46 visible departments. -->
		<LinearLayout
			android:id="@+id/empty_state"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="32dp"
			android:gravity="center_horizontal"
			android:orientation="vertical"
			android:visibility="gone">
			<TextView
				android:id="@+id/search_result_subtitle"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:gravity="center_horizontal"
				android:textAppearance="@style/TextAppearance.MedBook.Title"
				android:textColor="?colorOnSurface" />
			<TextView
				android:id="@+id/search_result_help"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="8dp"
				android:gravity="center_horizontal"
				android:text="@string/search_no_results_help"
				android:textAppearance="@style/TextAppearance.MedBook.Caption"
				android:textColor="?colorOnSurfaceVariant" />
			<com.google.android.material.button.MaterialButton
				android:id="@+id/browse_all"
				style="@style/Widget.Material3.Button.TextButton"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginTop="12dp"
				android:text="@string/browse_all_departments" />
		</LinearLayout>
		<ScrollView
			android:id="@+id/vscroll_specialty"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:clipToPadding="false"
			android:scrollbars="none">
			<!--
			  The 46 departments, grouped by the part of the body involved, because
			  that is what a patient knows before they know which specialty they need.
			  One rule, applied consistently, which is what keeps Neurology with
			  Neurosurgery, Nephrology with Kidney Transplant and Hepatology with
			  Liver Transplant.

			  Three families break the rule on purpose:
			    Women and children  a life stage. Every paediatric department lands
			                        here, Paediatric Cardiology included, because "is
			                        this for my child?" is a more reliable question
			                        than "which organ?".
			    Cancer              a disease, but the Cancer Care Centre is a place
			                        people look for by name.
			    Urgent and critical a mode of care. Nobody browses to Accident and
			                        Emergency by body part.

			  Each family is its own container so the dividers between rows stay inside
			  a group instead of running under its heading, and so a family can be
			  hidden whole when a search empties it.

			  Stage 2 moves all of this out of the layout and into data behind a
			  RecyclerView; see the roadmap in the README.
			-->
			<LinearLayout
				android:id="@+id/linear_specialty"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="vertical">
				<TextView
					android:id="@+id/header_urgent_critical_care"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="14dp"
					android:layout_marginBottom="2dp"
					android:paddingStart="12dp"
					android:paddingEnd="12dp"
					android:text="Urgent &amp; critical care"
					android:textAppearance="@style/TextAppearance.MedBook.SectionHeader"
					android:textColor="?colorPrimary" />
				<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:divider="@drawable/divider_department"
					android:showDividers="middle"
					android:orientation="vertical">
					<com.google.android.material.button.MaterialButton
						android:id="@+id/accident_and_emegerency"
						style="@style/Widget.MedBook.Department.Row"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:text="Accident &amp; Emergency" />

<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical">
	<!--
	  focusableInTouchMode on the container, so it takes initial focus instead of the
	  SearchView. Without it the field is focused on launch and the soft keyboard opens
	  over the department list before the user has asked for it - visible on API 21,
	  where the keyboard covered everything below Cardiology Care Centre.
	-->
	<LinearLayout
		android:id="@+id/linear_bg_home"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:paddingLeft="16dp"
		android:paddingRight="16dp"
		android:background="?colorSurface"
		android:focusable="true"
		android:focusableInTouchMode="true"
		android:orientation="vertical">
		<TextView
			android:id="@+id/medbook_logo"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginBottom="8dp"
			android:padding="8dp"
			android:fontFamily="@font/gabarito_extrabold"
			android:text="@string/app_name"
			android:textAppearance="@style/TextAppearance.MedBook.Wordmark"
			android:textColor="?colorPrimary" />
		<androidx.appcompat.widget.SearchView
			android:id="@+id/search_docs"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:background="@drawable/bg_search"
			app:queryHint="@string/search_hint"
			app:iconifiedByDefault="false" />
		<!-- Only shown when a search of at least 2 characters matches nothing.
		     It used to be a permanently visible "No doctors found" line sitting
		     above the whole department list. -->
		<LinearLayout
			android:id="@+id/empty_state"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="32dp"
			android:gravity="center_horizontal"
			android:orientation="vertical"
			android:visibility="gone">
			<TextView
				android:id="@+id/search_result_subtitle"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:gravity="center_horizontal"
				android:textAppearance="@style/TextAppearance.MedBook.Title"
				android:textColor="?colorOnSurface" />
			<TextView
				android:id="@+id/search_result_help"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="8dp"
				android:text="@string/search_no_results_help"
				android:gravity="center_horizontal"
				android:textAppearance="@style/TextAppearance.MedBook.Caption"
				android:textColor="?colorOnSurfaceVariant" />
			<com.google.android.material.button.MaterialButton
				android:id="@+id/browse_all"
				style="@style/Widget.Material3.Button.TextButton"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginTop="12dp"
				android:text="@string/browse_all_departments" />
		</LinearLayout>
		<!--
		  Shown while the directory is unpacked on first launch. That is a one-time
		  ~2s decrypt and decompress of a 12MB database on the emulator, and it only
		  repeats when the app or the dataset is updated. Without something here the
		  screen is an empty list for two seconds, which reads as a broken app.
		-->
		<LinearLayout
			android:id="@+id/loading_state"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:gravity="center"
			android:orientation="vertical">
			<ProgressBar
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:indeterminate="true" />
			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginTop="16dp"
				android:text="@string/directory_preparing"
				android:textAppearance="@style/TextAppearance.MedBook.Caption"
				android:textColor="?colorOnSurfaceVariant" />
		</LinearLayout>
		<!--
		  The departments, grouped by the part of the body involved, because that
		  is what a patient knows before they know which specialty they need.

		  The grouping rule and the three families that break it on purpose are
		  documented alongside the data now, in pipeline/departments.json in the
		  dataset archive - the same file that maps each department onto the source's
		  specialty vocabulary. Keeping the rule next to the mapping it governs is the
		  point of having moved this out of the layout.

		  Dividers moved onto the rows themselves (see item_department.xml), because a
		  RecyclerView has no equivalent of showDividers="middle".
		-->
		<androidx.recyclerview.widget.RecyclerView
			android:id="@+id/department_list"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:clipToPadding="false"
			android:scrollbars="none"
			android:visibility="gone" />
	</LinearLayout>
</LinearLayout>

					<com.google.android.material.button.MaterialButton
						android:id="@+id/anesthesia_and_pain_medicine"
						style="@style/Widget.MedBook.Department.Row"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:text="Anesthesia and Pain Medicine" />
				</LinearLayout>
				<TextView
					android:id="@+id/header_heart_lungs_blood"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"

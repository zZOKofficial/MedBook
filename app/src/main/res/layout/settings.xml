<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
	android:id="@+id/settings_root"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="?colorSurface"
	android:fillViewport="true">
	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical"
		android:paddingLeft="16dp"
		android:paddingRight="16dp">
		<!-- Same chrome as the department and doctor screens: the theme is NoActionBar
		     and a 44dp back button is the whole of it. -->
		<ImageButton
			android:id="@+id/back_button"
			android:layout_width="44dp"
			android:layout_height="44dp"
			android:layout_marginTop="4dp"
			android:background="?attr/selectableItemBackgroundBorderless"
			android:contentDescription="@string/back"
			android:scaleType="center"
			android:src="@drawable/ic_back" />
		<TextView
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="4dp"
			android:layout_marginBottom="8dp"
			android:paddingStart="12dp"
			android:paddingEnd="12dp"
			android:text="@string/settings"
			android:textAppearance="@style/TextAppearance.MedBook.Title"
			android:textColor="?colorOnSurface" />

		<TextView
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="16dp"
			android:paddingStart="12dp"
			android:paddingEnd="12dp"
			android:text="@string/settings_appearance"
			android:textAppearance="@style/TextAppearance.MedBook.SectionHeader"
			android:textColor="?colorPrimary" />
		<TextView
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="8dp"
			android:paddingStart="12dp"
			android:paddingEnd="12dp"
			android:text="@string/settings_theme"
			android:textAppearance="@style/TextAppearance.MedBook.Body"
			android:textColor="?colorOnSurface" />
		<RadioGroup
			android:id="@+id/theme_group"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="4dp"
			android:orientation="vertical">
			<RadioButton
				android:id="@+id/theme_system"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:minHeight="48dp"
				android:paddingStart="12dp"
				android:paddingEnd="12dp"
				android:text="@string/theme_system"
				android:textAppearance="@style/TextAppearance.MedBook.Body"
				android:textColor="?colorOnSurface" />
			<RadioButton
				android:id="@+id/theme_light"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:minHeight="48dp"
				android:paddingStart="12dp"
				android:paddingEnd="12dp"
				android:text="@string/theme_light"
				android:textAppearance="@style/TextAppearance.MedBook.Body"
				android:textColor="?colorOnSurface" />
			<RadioButton
				android:id="@+id/theme_dark"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:minHeight="48dp"
				android:paddingStart="12dp"
				android:paddingEnd="12dp"
				android:text="@string/theme_dark"
				android:textAppearance="@style/TextAppearance.MedBook.Body"
				android:textColor="?colorOnSurface" />
		</RadioGroup>
		<!-- Only visible below Android 10, where "Follow the device" cannot mean what
		     it says: there is no system dark setting that far back. -->
		<TextView
			android:id="@+id/theme_system_note"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="4dp"
			android:layout_marginBottom="8dp"
			android:paddingStart="12dp"
			android:paddingEnd="12dp"
			android:text="@string/theme_system_legacy_note"
			android:textAppearance="@style/TextAppearance.MedBook.Caption"
			android:textColor="?colorOnSurfaceVariant"
			android:visibility="gone" />
	</LinearLayout>
</ScrollView>

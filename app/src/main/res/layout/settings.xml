<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
	android:id="@+id/settings_root"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="?colorSurface"
	android:fillViewport="true">
	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical"
		android:paddingLeft="@dimen/screen_gutter"
		android:paddingRight="@dimen/screen_gutter">
		<!-- Same chrome as the department and doctor screens: the theme is NoActionBar
		     and a 44dp back button is the whole of it. -->
		<ImageButton
			android:id="@+id/back_button"
			style="@style/Widget.MedBook.BackButton"
			android:contentDescription="@string/back" />
		<TextView
			style="@style/Widget.MedBook.ScreenTitle"
			android:text="@string/settings" />

		<!--
		  Theme and language are collapsed rows rather than open radio groups. Nine
		  rows used to sit here at one level, every choice shown at once, and the page
		  grew by three more every time a three-way setting was added. A row that names
		  its own current value says the same thing in two lines and holds its size.
		-->
		<TextView
			style="@style/Widget.MedBook.SectionHeader"
			android:text="@string/settings_appearance" />
		<include
			android:id="@+id/theme_row"
			layout="@layout/setting_row"
			android:layout_width="match_parent"
			android:layout_height="wrap_content" />
		<View style="@style/Widget.MedBook.Divider" />
		<include
			android:id="@+id/language_row"
			layout="@layout/setting_row"
			android:layout_width="match_parent"
			android:layout_height="wrap_content" />

		<!-- Demo mode. Off unless it is switched on here, and when it is off nothing
		     anywhere else in the app shows any sign that it exists. One row, the same
		     shape as every other row: the disclosure ("nothing is booked") sits as
		     the switch's own summary line rather than a separate caption underneath,
		     because attached to the control it describes it is harder to miss. -->
		<TextView
			style="@style/Widget.MedBook.SectionHeader"
			android:text="@string/settings_demo" />
		<include
			android:id="@+id/demo_row"
			layout="@layout/setting_row_switch"
			android:layout_width="match_parent"
			android:layout_height="wrap_content" />
		<View style="@style/Widget.MedBook.Divider" />
		<include
			android:id="@+id/demo_reset_row"
			layout="@layout/setting_row"
			android:layout_width="match_parent"
			android:layout_height="wrap_content" />

		<!-- One row: About MedBook. Privacy and licences moved inside it, so this is
		     the only route to either - see AboutActivity. -->
		<TextView
			style="@style/Widget.MedBook.SectionHeader"
			android:text="@string/settings_about" />
		<include
			android:id="@+id/about_row"
			layout="@layout/setting_row"
			android:layout_width="match_parent"
			android:layout_height="wrap_content" />

		<View
			android:layout_width="match_parent"
			android:layout_height="@dimen/screen_bottom_gap" />
	</LinearLayout>
</ScrollView>

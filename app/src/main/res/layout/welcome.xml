<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:id="@+id/welcome_root"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="?colorSurface"
	android:orientation="vertical"
	android:paddingLeft="16dp"
	android:paddingRight="16dp">
	<!--
	  The content scrolls and the button does not. On a short screen the last point
	  would otherwise push Continue off the bottom, which on the one screen a person
	  cannot get past is the worst place for it to happen.
	-->
	<ScrollView
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_weight="1"
		android:fillViewport="true">
		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical">
			<TextView
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="32dp"
				android:paddingStart="12dp"
				android:paddingEnd="12dp"
				android:fontFamily="@font/gabarito_extrabold"
				android:text="@string/app_name"
				android:textAppearance="@style/TextAppearance.MedBook.Wordmark"
				android:textColor="?colorPrimary" />
			<TextView
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="20dp"
				android:layout_marginBottom="8dp"
				android:paddingStart="12dp"
				android:paddingEnd="12dp"
				android:text="@string/welcome_title"
				android:textAppearance="@style/TextAppearance.MedBook.Title"
				android:textColor="?colorOnSurface" />

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="14dp"
				android:orientation="horizontal"
				android:paddingStart="12dp"
				android:paddingEnd="12dp">
				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginEnd="10dp"
					android:text="@string/bullet"
					android:textAppearance="@style/TextAppearance.MedBook.Body"
					android:textColor="?colorPrimary" />
				<TextView
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:lineSpacingExtra="3dp"
					android:text="@string/welcome_point_permissions"
					android:textAppearance="@style/TextAppearance.MedBook.Body"
					android:textColor="?colorOnSurfaceVariant" />
			</LinearLayout>

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="14dp"
				android:orientation="horizontal"
				android:paddingStart="12dp"
				android:paddingEnd="12dp">
				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginEnd="10dp"
					android:text="@string/bullet"
					android:textAppearance="@style/TextAppearance.MedBook.Body"
					android:textColor="?colorPrimary" />
				<TextView
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:lineSpacingExtra="3dp"
					android:text="@string/welcome_point_offline"
					android:textAppearance="@style/TextAppearance.MedBook.Body"
					android:textColor="?colorOnSurfaceVariant" />
			</LinearLayout>

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="14dp"
				android:orientation="horizontal"
				android:paddingStart="12dp"
				android:paddingEnd="12dp">
				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginEnd="10dp"
					android:text="@string/bullet"
					android:textAppearance="@style/TextAppearance.MedBook.Body"
					android:textColor="?colorPrimary" />
				<TextView
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:lineSpacingExtra="3dp"
					android:text="@string/welcome_point_leaves"
					android:textAppearance="@style/TextAppearance.MedBook.Body"
					android:textColor="?colorOnSurfaceVariant" />
			</LinearLayout>

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="14dp"
				android:orientation="horizontal"
				android:paddingStart="12dp"
				android:paddingEnd="12dp">
				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginEnd="10dp"
					android:text="@string/bullet"
					android:textAppearance="@style/TextAppearance.MedBook.Body"
					android:textColor="?colorPrimary" />
				<TextView
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:lineSpacingExtra="3dp"
					android:text="@string/welcome_point_listings"
					android:textAppearance="@style/TextAppearance.MedBook.Body"
					android:textColor="?colorOnSurfaceVariant" />
			</LinearLayout>

			<View
				android:layout_width="match_parent"
				android:layout_height="1dp"
				android:layout_marginStart="12dp"
				android:layout_marginEnd="12dp"
				android:layout_marginTop="24dp"
				android:background="?colorOutlineVariant" />
			<include
				android:id="@+id/full_notice_row"
				layout="@layout/setting_row"
				android:layout_width="match_parent"
				android:layout_height="wrap_content" />
			<View
				android:layout_width="match_parent"
				android:layout_height="1dp"
				android:layout_marginStart="12dp"
				android:layout_marginEnd="12dp"
				android:background="?colorOutlineVariant" />
			<View
				android:layout_width="match_parent"
				android:layout_height="16dp" />
		</LinearLayout>
	</ScrollView>
	<com.google.android.material.button.MaterialButton
		android:id="@+id/continue_button"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="8dp"
		android:layout_marginBottom="20dp"
		android:minHeight="52dp"
		android:text="@string/welcome_continue" />
</LinearLayout>

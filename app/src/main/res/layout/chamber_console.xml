<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/console_root"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="?colorSurface"
	android:orientation="vertical"
	android:paddingLeft="16dp"
	android:paddingRight="16dp">
	<ImageButton
		android:id="@+id/back_button"
		style="@style/Widget.MedBook.BackButton"
		android:contentDescription="@string/back" />
	<TextView
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="4dp"
		android:background="?colorErrorContainer"
		android:padding="10dp"
		android:text="@string/demo_banner"
		android:textAppearance="@style/TextAppearance.MedBook.Caption"
		android:textColor="?colorOnErrorContainer" />
	<TextView
		android:id="@+id/console_chamber"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="12dp"
		android:paddingStart="12dp"
		android:paddingEnd="12dp"
		android:textAppearance="@style/TextAppearance.MedBook.Title"
		android:textColor="?colorOnSurface"
		tools:text="Example Specialised Hospital" />
	<TextView
		android:id="@+id/console_doctor"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:paddingStart="12dp"
		android:paddingEnd="12dp"
		android:textAppearance="@style/TextAppearance.MedBook.Caption"
		android:textColor="?colorOnSurfaceVariant"
		tools:text="Dr. Example Rahman" />
	<HorizontalScrollView
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="12dp"
		android:clipToPadding="false"
		android:paddingStart="12dp"
		android:paddingEnd="12dp"
		android:scrollbars="none">
		<LinearLayout
			android:id="@+id/day_strip"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:orientation="horizontal" />
	</HorizontalScrollView>
	<TextView
		android:id="@+id/console_utilisation"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="12dp"
		android:layout_marginBottom="6dp"
		android:paddingStart="12dp"
		android:paddingEnd="12dp"
		android:textAppearance="@style/TextAppearance.MedBook.Label"
		android:textColor="?colorSecondary"
		tools:text="18 of 24 booked · 75%" />
	<TextView
		android:id="@+id/console_empty"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="48dp"
		android:gravity="center_horizontal"
		android:text="@string/console_empty"
		android:textAppearance="@style/TextAppearance.MedBook.Caption"
		android:textColor="?colorOnSurfaceVariant"
		android:visibility="gone" />
	<androidx.recyclerview.widget.RecyclerView
		android:id="@+id/console_list"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:clipToPadding="false"
		android:scrollbars="none" />
</LinearLayout>

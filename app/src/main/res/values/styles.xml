<resources>

	<!--
	  Typography is defined once here as a scale, not applied per view at runtime.
	  Each role names a concrete font file, so no weight is ever synthesised.

	    Display   Gabarito ExtraBold 800   34sp   wordmark
	    Title     Hind Siliguri Bold 700   20sp   section headers
	    Label     Hind Siliguri SemiBold   15sp   department buttons
	    Body      Hind Siliguri Regular    16sp   descriptions, tagline
	    Caption   Hind Siliguri Regular    13sp   empty state, hints
	-->

	<style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
		<item name="android:statusBarColor">@android:color/transparent</item>
		<item name="android:navigationBarColor">@android:color/transparent</item>
		<item name="android:windowLightStatusBar">?attr/isLightTheme</item>

		<!-- Deliberately no theme-level fontFamily. Setting one here overrides
		     the fontFamily declared by each textAppearance below, including on
		     views that name a face directly, which silently flattened the whole
		     app back to Hind Siliguri Regular. Type comes from the scale and the
		     widget styles instead. -->

		<!-- Material 3 components read the type scale rather than the theme's
		     fontFamily, so the scale itself has to be overridden. -->
		<item name="textAppearanceDisplaySmall">@style/TextAppearance.MedBook.Display</item>
		<item name="textAppearanceHeadlineSmall">@style/TextAppearance.MedBook.Display</item>
		<item name="textAppearanceTitleLarge">@style/TextAppearance.MedBook.Title</item>
		<item name="textAppearanceTitleMedium">@style/TextAppearance.MedBook.Title</item>
		<item name="textAppearanceLabelLarge">@style/TextAppearance.MedBook.Label</item>
		<item name="textAppearanceBodyLarge">@style/TextAppearance.MedBook.Body</item>
		<item name="textAppearanceBodyMedium">@style/TextAppearance.MedBook.Body</item>
		<item name="textAppearanceBodySmall">@style/TextAppearance.MedBook.Caption</item>

		<!-- MaterialButton resolves its font from its widget style, which the
		     theme fontFamily above would otherwise flatten back to Regular. -->
		<item name="materialButtonStyle">@style/Widget.MedBook.Button</item>
	</style>

	<style name="Widget.MedBook.Button" parent="Widget.Material3.Button">
		<item name="fontFamily">@font/hind_siliguri_semibold</item>
		<item name="android:fontFamily">@font/hind_siliguri_semibold</item>
		<item name="android:textSize">15sp</item>
		<item name="android:letterSpacing">0.01</item>
		<item name="android:textAllCaps">false</item>
	</style>

	<style name="TextAppearance.MedBook.Display" parent="TextAppearance.Material3.DisplaySmall">
		<item name="fontFamily">@font/gabarito_extrabold</item>
		<item name="android:fontFamily">@font/gabarito_extrabold</item>
		<item name="android:textSize">34sp</item>
		<item name="android:letterSpacing">-0.02</item>
	</style>

	<style name="TextAppearance.MedBook.Wordmark" parent="TextAppearance.MedBook.Display">
		<item name="android:textSize">26sp</item>
	</style>

	<style name="TextAppearance.MedBook.Title" parent="TextAppearance.Material3.TitleLarge">
		<item name="fontFamily">@font/hind_siliguri_bold</item>
		<item name="android:fontFamily">@font/hind_siliguri_bold</item>
		<item name="android:textSize">20sp</item>
		<item name="android:letterSpacing">0</item>
	</style>

	<style name="TextAppearance.MedBook.Label" parent="TextAppearance.Material3.LabelLarge">
		<item name="fontFamily">@font/hind_siliguri_semibold</item>
		<item name="android:fontFamily">@font/hind_siliguri_semibold</item>
		<item name="android:textSize">15sp</item>
		<item name="android:letterSpacing">0.01</item>
		<item name="android:textAllCaps">false</item>
	</style>

	<style name="TextAppearance.MedBook.Body" parent="TextAppearance.Material3.BodyLarge">
		<item name="fontFamily">@font/hind_siliguri_regular</item>
		<item name="android:fontFamily">@font/hind_siliguri_regular</item>
		<item name="android:textSize">16sp</item>
	</style>

	<style name="TextAppearance.MedBook.Caption" parent="TextAppearance.Material3.BodySmall">
		<item name="fontFamily">@font/hind_siliguri_regular</item>
		<item name="android:fontFamily">@font/hind_siliguri_regular</item>
		<item name="android:textSize">13sp</item>
	</style>


	<!-- Shown by the system while the process starts, replacing the old
	     MainActivity that sat on a 500ms Timer. postSplashScreenTheme hands
	     over to AppTheme once HomeActivity is ready to draw. -->
	<style name="Theme.MedBook.Splash" parent="Theme.SplashScreen">
		<item name="windowSplashScreenBackground">@color/splash_background</item>
		<item name="windowSplashScreenAnimatedIcon">@drawable/medbook_icon</item>
		<item name="postSplashScreenTheme">@style/AppTheme</item>
	</style>

	<style name="AppTheme.FullScreen" parent="AppTheme">
		<item name="android:windowFullscreen">true</item>
		<item name="android:windowContentOverlay">@null</item>
	</style>
	<style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.Material3" />
	<style name="AppTheme.PopupOverlay" parent="ThemeOverlay.Material3" />
</resources>

<resources>

	<!--
	  Typography is defined once here as a scale, not applied per view at runtime.
	  Each role names a concrete font file, so no weight is ever synthesised.

	    Display   Gabarito ExtraBold 800   34sp   wordmark
	    Title     Hind Siliguri Bold 700   20sp   section headers
	    Label     Hind Siliguri SemiBold   15sp   department and doctor rows
	    Body      Hind Siliguri Regular    16sp   descriptions, tagline
	    Caption   Hind Siliguri Regular    13sp   empty state, hints
	-->

	<style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
		<item name="android:statusBarColor">@android:color/transparent</item>
		<item name="android:navigationBarColor">@android:color/transparent</item>
		<item name="android:windowLightStatusBar">?attr/isLightTheme</item>

		<!--
		  The M3 colour scheme, seeded from #1976D2. Without these the theme
		  falls back to the Material baseline, which is purple - which is why
		  colorPrimary sat in colors.xml for months doing nothing. Values live
		  in colors_m3.xml and values-night/colors_m3.xml.
		-->
		<item name="colorPrimary">@color/md_primary</item>
		<item name="colorOnPrimary">@color/md_on_primary</item>
		<item name="colorPrimaryContainer">@color/md_primary_container</item>
		<item name="colorOnPrimaryContainer">@color/md_on_primary_container</item>
		<item name="colorPrimaryInverse">@color/md_inverse_primary</item>
		<item name="colorSecondary">@color/md_secondary</item>
		<item name="colorOnSecondary">@color/md_on_secondary</item>
		<item name="colorSecondaryContainer">@color/md_secondary_container</item>
		<item name="colorOnSecondaryContainer">@color/md_on_secondary_container</item>
		<item name="colorTertiary">@color/md_tertiary</item>
		<item name="colorOnTertiary">@color/md_on_tertiary</item>
		<item name="colorTertiaryContainer">@color/md_tertiary_container</item>
		<item name="colorOnTertiaryContainer">@color/md_on_tertiary_container</item>
		<item name="colorError">@color/md_error</item>
		<item name="colorOnError">@color/md_on_error</item>
		<item name="colorErrorContainer">@color/md_error_container</item>
		<item name="colorOnErrorContainer">@color/md_on_error_container</item>
		<item name="android:colorBackground">@color/md_background</item>
		<item name="colorOnBackground">@color/md_on_background</item>
		<item name="colorSurface">@color/md_surface</item>
		<item name="colorOnSurface">@color/md_on_surface</item>
		<item name="colorSurfaceVariant">@color/md_surface_variant</item>
		<item name="colorOnSurfaceVariant">@color/md_on_surface_variant</item>
		<item name="colorSurfaceInverse">@color/md_inverse_surface</item>
		<item name="colorOnSurfaceInverse">@color/md_inverse_on_surface</item>
		<item name="colorOutline">@color/md_outline</item>
		<item name="colorOutlineVariant">@color/md_outline_variant</item>
		<item name="colorSurfaceDim">@color/md_surface_dim</item>
		<item name="colorSurfaceBright">@color/md_surface_bright</item>
		<item name="colorSurfaceContainerLowest">@color/md_surface_container_lowest</item>
		<item name="colorSurfaceContainerLow">@color/md_surface_container_low</item>
		<item name="colorSurfaceContainer">@color/md_surface_container</item>
		<item name="colorSurfaceContainerHigh">@color/md_surface_container_high</item>
		<item name="colorSurfaceContainerHighest">@color/md_surface_container_highest</item>
		<item name="android:colorEdgeEffect">@color/md_primary</item>


		<!-- Deliberately no theme-level fontFamily. Setting one here overrides
		     the fontFamily declared by each textAppearance below, including on
		     views that name a face directly, which silently flattened the whole
		     app back to Hind Siliguri Regular. Type comes from the scale and the
		     widget styles instead. -->

		<!-- Material 3 components read the type scale rather than the theme's
		     fontFamily, so the scale itself has to be overridden. -->
		<item name="textAppearanceDisplaySmall">@style/TextAppearance.MedBook.Display</item>
		<item name="textAppearanceHeadlineSmall">@style/TextAppearance.MedBook.Display</item>
		<item name="textAppearanceTitleLarge">@style/TextAppearance.MedBook.Title</item>
		<item name="textAppearanceTitleMedium">@style/TextAppearance.MedBook.Title</item>
		<item name="textAppearanceLabelLarge">@style/TextAppearance.MedBook.Label</item>
		<item name="textAppearanceBodyLarge">@style/TextAppearance.MedBook.Body</item>
		<item name="textAppearanceBodyMedium">@style/TextAppearance.MedBook.Body</item>
		<item name="textAppearanceBodySmall">@style/TextAppearance.MedBook.Caption</item>

		<!-- MaterialButton resolves its font from its widget style, which the
		     theme fontFamily above would otherwise flatten back to Regular. -->
		<item name="materialButtonStyle">@style/Widget.MedBook.Button</item>
	</style>

	<style name="Widget.MedBook.Button" parent="Widget.Material3.Button">
		<item name="fontFamily">@font/hind_siliguri_semibold</item>
		<item name="android:fontFamily">@font/hind_siliguri_semibold</item>
		<item name="android:textSize">15sp</item>
		<item name="android:letterSpacing">0.01</item>
		<item name="android:textAllCaps">false</item>
	</style>

	<style name="TextAppearance.MedBook.SectionHeader" parent="TextAppearance.Material3.LabelMedium">
		<item name="fontFamily">@font/hind_siliguri_bold</item>
		<item name="android:fontFamily">@font/hind_siliguri_bold</item>
		<item name="android:textSize">12sp</item>
		<item name="android:letterSpacing">0.08</item>
		<item name="android:textAllCaps">true</item>
	</style>

	<style name="TextAppearance.MedBook.Display" parent="TextAppearance.Material3.DisplaySmall">
		<item name="fontFamily">@font/gabarito_extrabold</item>
		<item name="android:fontFamily">@font/gabarito_extrabold</item>
		<item name="android:textSize">34sp</item>
		<item name="android:letterSpacing">-0.02</item>
	</style>

	<style name="TextAppearance.MedBook.Wordmark" parent="TextAppearance.MedBook.Display">
		<item name="android:textSize">26sp</item>
	</style>

	<style name="TextAppearance.MedBook.Title" parent="TextAppearance.Material3.TitleLarge">
		<item name="fontFamily">@font/hind_siliguri_bold</item>
		<item name="android:fontFamily">@font/hind_siliguri_bold</item>
		<item name="android:textSize">20sp</item>
		<item name="android:letterSpacing">0</item>
	</style>

	<style name="TextAppearance.MedBook.Label" parent="TextAppearance.Material3.LabelLarge">
		<item name="fontFamily">@font/hind_siliguri_semibold</item>
		<item name="android:fontFamily">@font/hind_siliguri_semibold</item>
		<item name="android:textSize">15sp</item>
		<item name="android:letterSpacing">0.01</item>
		<item name="android:textAllCaps">false</item>
	</style>

	<style name="TextAppearance.MedBook.Body" parent="TextAppearance.Material3.BodyLarge">
		<item name="fontFamily">@font/hind_siliguri_regular</item>
		<item name="android:fontFamily">@font/hind_siliguri_regular</item>
		<item name="android:textSize">16sp</item>
	</style>

	<style name="TextAppearance.MedBook.Caption" parent="TextAppearance.Material3.BodySmall">
		<item name="fontFamily">@font/hind_siliguri_regular</item>
		<item name="android:fontFamily">@font/hind_siliguri_regular</item>
		<item name="android:textSize">13sp</item>
	</style>


	<!-- Shown by the system while the process starts, replacing the old
	     MainActivity that sat on a 500ms Timer. postSplashScreenTheme hands
	     over to AppTheme once HomeActivity is ready to draw.

	     No icon background colour, so the mark sits straight on the splash
	     background and the icon geometry is 288dp canvas / 192dp visible circle,
	     which is what splash_icon.xml is drawn against. The previous icon was a
	     646px square PNG filling 98% of its canvas, so the system's circular mask
	     cut off the calendar, its rings and the checkmark and left a teal disc. -->
	<style name="Theme.MedBook.Splash" parent="Theme.SplashScreen">
		<item name="windowSplashScreenBackground">@color/splash_background</item>
		<item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
		<item name="windowSplashScreenAnimationDuration">800</item>
		<item name="postSplashScreenTheme">@style/AppTheme</item>
	</style>

	<style name="AppTheme.FullScreen" parent="AppTheme">
		<item name="android:windowFullscreen">true</item>
		<item name="android:windowContentOverlay">@null</item>
	</style>
	<style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.Material3" />
	<style name="AppTheme.PopupOverlay" parent="ThemeOverlay.Material3" />
</resources>

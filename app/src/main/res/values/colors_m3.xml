<?xml version="1.0" encoding="utf-8"?>
<resources>

	<!--
	  Material 3 light scheme, generated from the two colours of the MedBook mark:
	  primary from the calendar header #1C5B6C, secondary from its body #42A4AB.
	  The app and its logo were different colours until 0.3; now they are not.

	  Material Color Utilities, Fidelity variant: it keeps the seed intact, so
	  md_primary_container is #1C5B6C exactly. TonalSpot, the M3 default, would
	  desaturate it into a grey-blue that is not the teal the mark is drawn in.

	  The raw logo colours are NOT used as text roles, because neither survives both
	  themes: #42A4AB reads at 2.8:1 on the light surface and #1C5B6C at 2.4:1 on the
	  dark one, against the 4.5:1 that body text needs. A tonal palette exists exactly
	  to solve that: light takes a darker tone of the same hue and dark takes a
	  lighter one, so the hue survives and the contrast does too.

	  Generated, not hand-picked. Regenerate rather than editing by hand.
	-->

	<color name="md_primary">#004352</color>
	<color name="md_on_primary">#FFFFFF</color>
	<color name="md_primary_container">#1C5B6C</color>
	<color name="md_on_primary_container">#98D1E5</color>
	<color name="md_inverse_primary">#96CFE3</color>
	<color name="md_secondary">#00696F</color>
	<color name="md_on_secondary">#FFFFFF</color>

<resources>
	<string name="app_name" translatable="false">MedBook</string>

	<string name="search_hint">Search doctors or departments</string>

	<!-- Shown only when a search of at least 2 characters matches nothing.
	     %1$s is the text the user typed. -->
	<string name="search_no_results">Nothing matches \"%1$s\"</string>
	<string name="search_no_results_help">Check the spelling, or try a broader word such as heart, child or skin.</string>
	<string name="browse_all_departments">Browse all departments</string>

	<!-- Headings above each kind of search result. -->
	<string name="results_departments">Departments</string>
	<string name="results_doctors">Doctors</string>

	<!-- First launch, while the directory is unpacked. -->
	<string name="directory_preparing">Preparing the directory…</string>
	<!-- Shown when the build shipped no directory data at all, which is what a
	     checkout without dataset.properties produces. Deliberately not phrased as an
	     error: building without the private dataset is supported. -->
	<string name="directory_unavailable">The doctor directory is not available in this build.</string>

	<!-- Department screen. %1$d is a number of doctors. -->
	<plurals name="department_doctor_count">
		<item quantity="one">%1$d doctor</item>
		<item quantity="other">%1$d doctors</item>
	</plurals>
	<string name="department_empty">No doctors are listed under this department yet.</string>

	<!-- Doctor detail. -->
	<string name="doctor_chambers">Chambers</string>
	<string name="doctor_about">About</string>
	<string name="doctor_bmdc">BMDC registration %1$s</string>
	<string name="doctor_verified">Verified</string>
	<!-- %1$.2f is the average rating, %2$d the number of reviews it is drawn from. -->
	<string name="doctor_rating">%1$.2f from %2$d reviews</string>
	<string name="chamber_call">Call</string>
	<string name="chamber_closed">Closed: %1$s</string>
	<string name="portrait_of">Portrait of %1$s</string>
	<string name="back">Back</string>
	<string name="no_dialer">No app on this device can make calls.</string>

	<!-- Settings. -->
	<string name="settings">Settings</string>
	<string name="settings_appearance">Appearance</string>
	<string name="settings_theme">Theme</string>
	<string name="theme_system">Follow the device</string>
	<!-- Shown under "Follow the device" only below Android 10, where there is no
	     system-wide dark setting to follow and the battery saver is the nearest thing. -->
	<string name="theme_system_legacy_note">This version of Android has no system dark mode, so MedBook follows the battery saver instead.</string>
	<string name="theme_light">Light</string>
	<string name="theme_dark">Dark</string>
	<string name="settings_language">Language</string>
	<string name="language_system">Follow the device</string>
	<!-- Language names are written in their own language, in every locale. -->
	<string name="language_english" translatable="false">English</string>
	<string name="language_bengali" translatable="false">বাংলা</string>

	<!-- Demo mode. A simulated booking system, off unless it is switched on in
	     Settings. Nothing it shows is real: no appointment is made, and nobody at
	     any chamber is told anything. Every string here says so somewhere. -->
	<string name="settings_demo">Demo</string>
	<string name="settings_demo_toggle">Simulated booking</string>
	<string name="settings_demo_note">Shows what booking would look like, using invented appointments. Nothing is booked and no chamber is contacted. For showing MedBook to hospitals.</string>
	<string name="settings_demo_reset">Reset demo bookings</string>
	<string name="settings_demo_reset_message">Every appointment taken in the demo will be forgotten. Nothing else about the demo changes.</string>
	<string name="settings_demo_reset_done">Demo bookings cleared.</string>
	<string name="settings_demo_reset_empty">There are no demo bookings to clear.</string>

	<!-- Shown on every demo screen, and deliberately hard to miss. -->
	<string name="demo_badge">DEMO</string>
	<string name="demo_banner">Simulated. Nothing is booked and no chamber is contacted.</string>

	<!-- Booking, all of it simulated. -->
	<string name="chamber_book">Book (demo)</string>
	<string name="chamber_console">Chamber view</string>
	<string name="booking_title">Choose a time</string>
	<string name="booking_today">Today</string>
	<string name="booking_closed">This chamber does not sit on this day.</string>
	<!-- %1$d is how many of the day&apos;s slots are still open. -->
	<plurals name="booking_free_count">
		<item quantity="one">%1$d time open</item>
		<item quantity="other">%1$d times open</item>
	</plurals>
	<string name="booking_confirm_title">Take this time?</string>
	<!-- %1$s is a time such as 5:20 pm, %2$s a date such as Sat 12 Sep. -->
	<string name="booking_confirm_message">%1$s on %2$s.\n\nThis is a demonstration. No appointment is made, and nobody at the chamber is told. To book for real, call the chamber.</string>
	<string name="booking_confirm_action">Take it in the demo</string>
	<string name="booking_cancel_title">Give up this time?</string>
	<string name="booking_cancel_action">Give it up</string>
	<string name="booking_cancelled">Demo booking removed.</string>
	<!-- %1$d is the serial the chamber would call out. -->
	<string name="booking_done">Taken in the demo. Serial %1$d.</string>
	<string name="cancel">Cancel</string>
	<string name="slot_free">Open</string>
	<string name="slot_taken">Taken</string>
	<string name="slot_yours">Yours</string>

	<!-- Chamber view: the same day, from the chamber&apos;s side of the desk. -->
	<string name="console_title">Chamber view</string>
	<!-- %1$d booked out of %2$d slots, %3$d the same as a percentage. -->
	<string name="console_utilisation">%1$d of %2$d booked \u00b7 %3$d%%</string>
	<string name="console_empty">Nothing is booked on this day.</string>
	<string name="console_you">You</string>
	<string name="console_no_show">did not attend</string>
	<!-- The serial on its own, in a column too narrow for a word. It is a
	     format argument rather than a bare number so that it renders in
	     Bengali numerals like every other count in the app. -->
	<string name="console_serial_number" translatable="false">%1$d</string>
	<!-- An empty slot in the chamber's book. -->
	<string name="console_free">—</string>


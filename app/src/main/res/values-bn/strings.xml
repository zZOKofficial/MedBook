	<!-- The privacy notice. -->
	<string name="privacy_title">গোপনীয়তা</string>
	<string name="privacy_collect_heading">মেডবুক কী সংগ্রহ করে</string>
	<string name="privacy_collect_body">কিছুই না। কোনো অ্যাকাউন্ট নেই, সাইন-ইন নেই, অ্যানালিটিক্স নেই, ক্র্যাশ রিপোর্টও নেই। মেডবুক আপনার কাছে কখনো নাম, নম্বর বা ঠিকানা চায়নি, আর পাঠানোর জায়গাও তার নেই।</string>
	<string name="privacy_network_heading">আপনার ফোন থেকে কী বাইরে যায়</string>
	<string name="privacy_network_body">কিছুই না। মেডবুকের ইন্টারনেট অনুমতি নেই, তাই চাইলেও সে কোনো নেটওয়ার্ক কল করতে পারে না। ডিরেক্টরি পড়া হয় অ্যাপের নিজস্ব সংরক্ষণ থেকে, কোনো সংযোগ ছাড়াই।</string>
	<string name="privacy_stored_heading">আপনার ফোনে কী জমা থাকে</string>
	<string name="privacy_stored_body">তিনটি জিনিস, সবই মেডবুকের ব্যক্তিগত সংরক্ষণে: প্রথমবার চালু করার সময় অ্যাপ থেকে খোলা ডাক্তার ডিরেক্টরি; আপনার থিম ও ভাষা; এবং ডেমো মোড চালু করে থাকলে সেখানে নেওয়া অ্যাপয়েন্টমেন্টগুলো।</string>
	<string name="privacy_directory_heading">ডিরেক্টরি কোথা থেকে এসেছে</string>
	<string name="privacy_directory_body">প্রকাশিত পেশাগত প্রোফাইল থেকে — নাম, ডিগ্রি, চেম্বারের ঠিকানা, বসার সময়, অ্যাপয়েন্টমেন্ট নম্বর ও বিএমডিসি নিবন্ধন নম্বর, যেভাবে তাদের উৎস প্রকাশ করেছে। এটি ডাক্তারদের সম্পর্কে প্রকাশিত তথ্য, আপনার সম্পর্কে কোনো রেকর্ড নয়, আর এর কিছুই চিকিৎসা-নথি নয়।</string>
	<string name="privacy_backup_heading">ব্যাকআপ</string>
	<string name="privacy_backup_body">আপনার থিম ও ভাষা নতুন ফোনে আপনার সঙ্গে যাবে, যেমনটা আপনি আশা করবেন। ডিরেক্টরি যাবে না: সেটি অ্যাপ থেকেই আবার তৈরি হয়। ডেমো বুকিং আর এই নোটিশ দেখানোর হিসাব ক্লাউড ব্যাকআপের বাইরে রাখা হয়, যাতে অন্য কারো ফোনে রিস্টোর হলে তাকে এই নোটিশ এড়িয়ে না গিয়ে দেখানো হয়।</string>
	<string name="privacy_calls_heading">চেম্বারে ফোন করা</string>
	<string name="privacy_calls_body">অ্যাপয়েন্টমেন্ট নম্বরে চাপ দিলে সেটি আপনার ফোনের নিজস্ব ডায়ালারে চলে যায়। মেডবুক কোনো কল করে না, আর আপনি যে চাপ দিয়েছেন তার কোনো হিসাবও রাখে না।</string>
	<string name="privacy_demo_heading">ডেমো মোড</string>
	<string name="privacy_demo_body">আপনি চালু না করলে বন্ধ। এর পেছনের সবকিছুই বানানো: কোনো অ্যাপয়েন্টমেন্ট হয় না, কোনো চেম্বারকে কিছু জানানো হয় না, আর চেম্বার ভিউয়ের রোগীরাও কাল্পনিক। তারা কারো নাম নয়।</string>
	<string name="privacy_corrections_heading">সংশোধন</string>
	<string name="privacy_corrections_body">আপনি ডিরেক্টরিতে আছেন এবং আপনার সম্পর্কে কিছু ভুল থাকলে, কিংবা আপনি একেবারেই তালিকাভুক্ত থাকতে না চাইলে, রিপোজিটরিতে একটি ইস্যু খুলুন — পরের ডেটাসেটে তা সংশোধন করা হবে।</string>

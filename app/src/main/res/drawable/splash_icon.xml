<?xml version="1.0" encoding="utf-8"?>
<!--
  The MedBook mark: a calendar carrying a medical cross and a check. It is the
  identity the app has had from the start, and the source of truth for it is
  medbook.svg in the repository root. Keep the two in step.

  Geometry follows the Android 12+ splash contract, which is the whole reason the
  mark is not simply dropped in at full size. With no icon background colour the
  system gives the icon a 288dp canvas and shows only the inner 192dp circle. The
  original medbook_icon.png filled 98% of its own canvas, so the mask ate the
  calendar body and left a teal disc with a cross in it.

  So the mark is inscribed rather than fitted: its bounding box is 626 x 623.3 in
  the 1024 space it was drawn in, a diagonal of 883.4, and it is scaled by
  192/883.4 = 0.21734 so that even its corners stay inside the 96 radius. That
  lands it at 136dp across, which is a shade under the ring this replaced.

  Colours are the logo`s own, not the theme`s. The mark is teal while the app is
  seeded from #1976D2, and that is deliberate: the identity predates the colour
  scheme and is not the theme`s to restyle.

  The static state below is the FINISHED mark, not the first frame. Below API 31
  the splash cannot animate and shows this drawable as-is; authored at the
  animation start, the launch icon would show a calendar with no check.
-->
<animated-vector
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:aapt="http://schemas.android.com/aapt">

	<aapt:attr name="android:drawable">
		<vector
			android:width="288dp"
			android:height="288dp"
			android:viewportWidth="288"
			android:viewportHeight="288">

			<group
				android:pivotX="511.5"
				android:pivotY="492.15"
				android:scaleX="0.21734"
				android:scaleY="0.21734"
				android:translateX="-367.5"
				android:translateY="-348.15">

				<!-- Header and the two binding tabs. -->
				<path
					android:fillColor="#1C5B6C"
					android:pathData="M 198.5 352 L 198.5 309 C 198.5 269.2 228.8 238.5 268.5 237.2 L 294.8 236.7 L 295.2 220.7 C 295.5 205.7 295.7 204.1 298.1 198.9 C 301.3 192.1 306.4 186.9 313.3 183.3 C 317.9 180.8 319.6 180.5 328 180.5 C 336.4 180.5 338.1 180.8 342.5 183.2 C 347.5 185.8 353.2 191.2 356.2 196.1 C 359.7 201.7 361 209.1 361 223.2 L 361 237 L 662.8 237 L 663.2 220.7 C 663.5 205.7 663.7 204.1 666.1 198.9 C 669.3 192.1 674.4 186.9 681.3 183.3 C 685.9 180.8 687.6 180.5 696 180.5 C 704.7 180.5 706 180.8 710.9 183.5 C 718.7 187.8 724.6 194.8 727 202.7 C 728.6 207.9 729 212 729 223 L 729 236.8 L 749 237.3 C 790.5 238.3 824.5 270.3 824.5 311 L 824.5 352 Z" />

				<!-- Calendar body. -->
				<path
					android:fillColor="#42A4AB"
					android:pathData="M 198.5 352 L 824.5 352 L 824.5 738 C 824.5 774.4 796.4 803.8 761.5 803.8 L 265.5 803.8 C 227.8 803.8 198.5 774.0 198.5 737 Z" />

				<!-- The cross. VectorDrawable has no rect element, so the two rounded
				     rectangles of the source SVG are written out as arcs. -->
				<path
					android:fillColor="#FEFEFD"
					android:pathData="M 463 390.5 L 561 390.5 A 15 15 0 0 1 576 405.5 L 576 683 A 15 15 0 0 1 561 698 L 463 698 A 15 15 0 0 1 448 683 L 448 405.5 A 15 15 0 0 1 463 390.5 Z" />
				<path
					android:fillColor="#FEFEFD"
					android:pathData="M 360 484 L 664 484 A 15 15 0 0 1 679 499 L 679 586 A 15 15 0 0 1 664 601 L 360 601 A 15 15 0 0 1 345 586 L 345 499 A 15 15 0 0 1 360 484 Z" />

				<!-- The check, which is the part that animates. -->
				<path
					android:name="check"
					android:pathData="M 634.5 690.5 L 680.5 734 L 768 638.5"
					android:strokeColor="#FEFEFD"
					android:strokeWidth="28"
					android:strokeLineCap="round"
					android:strokeLineJoin="round"
					android:trimPathStart="0"
					android:trimPathEnd="1" />
			</group>
		</vector>
	</aapt:attr>

	<!-- The check draws itself in, once the mark has been on screen long enough to
	     be read. The calendar is the identity; the check is the only thing that
	     needs to happen, so it is the only thing that moves. -->
	<target android:name="check">
		<aapt:attr name="android:animation">
			<objectAnimator
				android:propertyName="trimPathEnd"
				android:valueFrom="0"
				android:valueTo="1"
				android:valueType="floatType"
				android:startOffset="260"
				android:duration="440"
				android:interpolator="@android:interpolator/fast_out_slow_in" />
		</aapt:attr>
	</target>
</animated-vector>

<?xml version="1.0" encoding="utf-8"?>
<!-- Real weights, so android:textStyle="bold" selects the Bold file instead of
     letting the framework synthesise a fake bold from Regular. -->
<font-family
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto">
	<font
		android:font="@font/hind_siliguri_regular"
		android:fontStyle="normal"
		android:fontWeight="400"
		app:font="@font/hind_siliguri_regular"
		app:fontStyle="normal"
		app:fontWeight="400" />
	<font
		android:font="@font/hind_siliguri_semibold"
		android:fontStyle="normal"
		android:fontWeight="600"
		app:font="@font/hind_siliguri_semibold"
		app:fontStyle="normal"
		app:fontWeight="600" />
	<font
		android:font="@font/hind_siliguri_bold"
		android:fontStyle="normal"
		android:fontWeight="700"
		app:font="@font/hind_siliguri_bold"
		app:fontStyle="normal"
		app:fontWeight="700" />
</font-family>


<manifest
	xmlns:android="http://schemas.android.com/apk/res/android">

	<!-- No permissions. The directory ships inside the app and is read from local
	     storage, so there is nothing to request - not even network access. -->

	<application
		android:name=".MedBookApp"
		android:allowBackup="true"
		android:fullBackupContent="@xml/backup_rules"
		android:dataExtractionRules="@xml/data_extraction_rules"
		android:icon="@mipmap/ic_launcher"
		android:roundIcon="@mipmap/ic_launcher_round"
		android:label="@string/app_name"
		android:localeConfig="@xml/locales_config"
		android:theme="@style/AppTheme">
		<activity
			android:name=".HomeActivity"
			android:hardwareAccelerated="true"
			android:screenOrientation="portrait"
			android:theme="@style/Theme.MedBook.Splash"
			android:exported="true">
			<intent-filter>
				<action android:name="android.intent.action.MAIN" />
				<category android:name="android.intent.category.LAUNCHER" />
			</intent-filter>
		</activity>
		<activity
			android:name=".DepartmentDoctorsActivity"
			android:parentActivityName=".HomeActivity"
			android:screenOrientation="portrait"
			android:exported="false" />
		<activity
			android:name=".DoctorDetailActivity"
			android:parentActivityName=".DepartmentDoctorsActivity"
			android:screenOrientation="portrait"
			android:exported="false" />
		<!-- Both reachable only while demo mode is on, which is off unless it is
		     switched on in Settings. Neither is exported, and both leave themselves
		     if the mode goes off while they sit on the back stack. -->
		<activity
			android:name=".BookingActivity"
			android:parentActivityName=".DoctorDetailActivity"
			android:screenOrientation="portrait"
			android:exported="false" />
		<activity
			android:name=".ChamberConsoleActivity"
			android:parentActivityName=".DoctorDetailActivity"
			android:screenOrientation="portrait"
			android:exported="false" />
		<activity
			android:name=".SettingsActivity"
			android:parentActivityName=".HomeActivity"
			android:screenOrientation="portrait"
			android:exported="false" />
		<!-- The privacy notice, put up by PrivacyGate before anything else can be used.
		     No parentActivityName: it is a gate rather than a place in the hierarchy,
		     and back leaves the app rather than walking up out of it. -->
		<activity
			android:name=".WelcomeActivity"
			android:screenOrientation="portrait"
			android:exported="false" />
		<!-- All three only read: a version string, the privacy notice, and the
		     licences MedBook ships under. None of them touch the directory. -->
		<activity
			android:name=".AboutActivity"
			android:parentActivityName=".SettingsActivity"
			android:screenOrientation="portrait"
			android:exported="false" />
		<activity
			android:name=".PrivacyActivity"
			android:parentActivityName=".AboutActivity"
			android:screenOrientation="portrait"
			android:exported="false" />
		<activity
			android:name=".LicencesActivity"
			android:parentActivityName=".AboutActivity"
			android:screenOrientation="portrait"
			android:exported="false" />
	</application>
</manifest>
